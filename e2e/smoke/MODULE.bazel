bazel_dep(name = "rules_aptprep", version = "0.0.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

local_path_override(
    module_name = "rules_aptprep",
    path = "../..",
)

aptprep = use_extension("@rules_aptprep//aptprep:extensions.bzl", "aptprep")
aptprep.toolchain(
    archive_url = "https://github.com/nickguletskii/aptprep/releases/download/v0.1.2/aptprep_linux_x86_64.tar",
    sha256 = "4d1b992540fb9856561f101d8ef4a54b7e74529a65171468f7940933ad0a0e52",
)
aptprep.lockfile(
    config = "//:aptprep.yaml",
    lockfile = "//:lockfile.json",
    lockfile_name = "smoke",
)
aptprep.packages(
    lockfile_name = "smoke",
    repo_name = "aptprep_smoke_packages",
)
aptprep.sysroot(
    add_files = {
        "etc/custom_config.txt": "//:custom_config.txt",
    },
    lockfile_name = "smoke",
    packages_list = [
        "bash",
        "curl",
    ],
    repo_name = "aptprep_smoke_sysroot",
)
aptprep.sysroot(
    archive_extractor = "tar",
    lockfile_name = "smoke",
    packages_list = [
        "bash",
        "curl",
    ],
    patch_binaries = False,
    repo_name = "aptprep_smoke_sysroot_tar",
)
aptprep.sysroot(
    archive_extractor = "bazel",
    lockfile_name = "smoke",
    packages_list = [
        "bash",
        "curl",
    ],
    patch_binaries = False,
    repo_name = "aptprep_smoke_sysroot_bazel",
)
use_repo(
    aptprep,
    "aptprep_binary_archive",
    "aptprep_smoke_packages",
    "aptprep_smoke_sysroot",
    "aptprep_smoke_sysroot_bazel",
    "aptprep_smoke_sysroot_tar",
    "aptprep_toolchains",
)

extraction_comparison = use_extension("//:extraction_comparison_ext.bzl", "extraction_comparison")
extraction_comparison.compare(
    name = "aptprep_extraction_comparison",
    bazel_manifest = "@aptprep_smoke_sysroot_bazel//:install_manifest.json",
    tar_manifest = "@aptprep_smoke_sysroot_tar//:install_manifest.json",
)
use_repo(extraction_comparison, "aptprep_extraction_comparison")

register_toolchains("@aptprep_toolchains//:all")
