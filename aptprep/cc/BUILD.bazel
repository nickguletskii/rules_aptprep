load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "cc_toolchain_config",
    srcs = ["cc_toolchain_config.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_cc//cc:action_names_bzl",
        # cc_toolchain_config.bzl loads @rules_cc//cc:cc_toolchain_config_lib.bzl,
        # but that module's bzl_library is internal to rules_cc
        # (visibility @rules_cc//cc:__subpackages__). Depend on the public
        # defs_bzl, which transitively covers cc_toolchain_config_lib_bzl, so the
        # generated doc_extract resolves without an illegal direct edge.
        "@rules_cc//cc:defs_bzl",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":cc_toolchain_config",
        "@rules_cc//cc:defs_bzl",
    ],
)
